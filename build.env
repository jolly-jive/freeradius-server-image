# What to build. Read by .github/workflows/build.yml (sourced as shell).
# The image tag is <version>-devel-${DIST}-<first 7 hex of UPSTREAM_REF>-r${BUILD},
# where <version> is what the server reports for that commit (e.g. 4.0.40537).

# Commit of FreeRADIUS/freeradius-server to build (full 40-hex SHA).
UPSTREAM_REF=c39eabea3a720591548199bbfabbc33c7a72d2b5

# Directory under scripts/docker/build/ in the upstream tree.
DIST=ubuntu26

# Raise this to rebuild the same commit (e.g. to pick up base image updates).
# Published tags are never overwritten.
BUILD=1
